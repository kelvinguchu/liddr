{
  "name": "liddr-ops",
  "private": true,
  "version": "0.1.0",
  "description": "The Liddr staff console: a TanStack Start service that calls the API's /v1 routes on the same origin.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "tsc --noEmit && vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/lib/*.test.ts",
    "generate": "openapi-typescript ../../packages/contract/openapi.yaml -o src/lib/contract.gen.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.562.0",
    "next-themes": "0.4.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "nitro": "3.0.260903-beta",
    "openapi-typescript": "^7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
