POSTGRES_DB=liddr_rides
POSTGRES_USER=liddr_api
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}

REDIS_PASSWORD=change_me
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

SECRET_KEY_BASE=generate_with_mix_phx_gen_secret
PHX_HOST=localhost
PORT=4000
POOL_SIZE=48
DB_QUEUE_TARGET_MS=100
DB_QUEUE_INTERVAL_MS=2000
DRIVER_LOCATION_DB_MIN_INTERVAL_MS=1000
DRIVER_LOCATION_DB_FORCE_PERSIST_DISTANCE_M=25

# Auth debugging (development only)
AUTH_DEBUG_OTP=false
# Comma-separated normalized identifiers allowed for OTP debug logging/response.
# Example: AUTH_DEBUG_OTP_TARGETS=254725799783,254700000001
AUTH_DEBUG_OTP_TARGETS=
STEP_UP_TTL_SECONDS=300
# OTP abuse controls
AUTH_CHALLENGE_COOLDOWN_SECONDS=30
AUTH_CHALLENGE_IDENTITY_WINDOW_SECONDS=900
AUTH_CHALLENGE_IDENTITY_MAX_REQUESTS=5
AUTH_CHALLENGE_IP_WINDOW_SECONDS=900
AUTH_CHALLENGE_IP_MAX_REQUESTS=60
AUTH_CHALLENGE_DEVICE_WINDOW_SECONDS=900
AUTH_CHALLENGE_DEVICE_MAX_REQUESTS=40
# Disputes/Reports abuse controls
DISPUTE_CREATE_WINDOW_SECONDS=3600
DISPUTE_CREATE_MAX_REQUESTS=6
REPORT_CREATE_WINDOW_SECONDS=3600
REPORT_CREATE_MAX_REQUESTS=12
REPORT_TRIAGE_WINDOW_SECONDS=3600
REPORT_TRIAGE_MAX_REQUESTS=120
REPORT_REVIEW_WINDOW_SECONDS=3600
REPORT_REVIEW_MAX_REQUESTS=80
RIDE_MESSAGE_REPORT_WINDOW_SECONDS=3600
RIDE_MESSAGE_REPORT_MAX_REQUESTS=8
DISPUTE_OPS_RESOLUTION_WINDOW_SECONDS=3600
DISPUTE_OPS_RESOLUTION_MAX_REQUESTS=30
OTP_APP_NAME=Liddr
OTP_APP_DOMAIN=liddr.app

# SMS OTP delivery (HostPinnacle)
HOSTPINNACLE_API_URL=https://smsportal.hostpinnacle.co.ke/SMSApi/send
HOSTPINNACLE_USER_ID=your_hostpinnacle_user_id
HOSTPINNACLE_PASSWORD=your_hostpinnacle_password
HOSTPINNACLE_API_KEY=your_hostpinnacle_api_key
HOSTPINNACLE_SENDER_ID=your_hostpinnacle_sender_id
HOSTPINNACLE_TIMEOUT_MS=15000

# Email OTP delivery (Resend)
RESEND_API_KEY=your_resend_api_key
OTP_EMAIL_FROM=Liddr <security@your-verified-domain.example>
# RESEND_API_URL=https://api.resend.com/emails
RESEND_TIMEOUT_MS=15000

# M-Pesa (Daraja)
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
MPESA_INITIATOR_NAME=your_mpesa_initiator_name
MPESA_SECURITY_CREDENTIAL=your_mpesa_security_credential
MPESA_IDENTIFIER_TYPE=4
MPESA_C2B_COMMAND_ID=CustomerPayBillOnline
# Daraja C2B register endpoint (Daraja 3.0 default shown here)
MPESA_C2B_REGISTER_PATH=/mpesa/c2b/v2/registerurl
MPESA_TRANSACTION_STATUS_COMMAND_ID=TransactionStatusQuery
MPESA_CALLBACK_BASE_URL=https://your-public-api-base.example.com
# Optional callback token used to verify M-Pesa callbacks (STK, C2B, tx status).
MPESA_CALLBACK_TOKEN=change_me
# Callback token transport: query | header | query_or_header
MPESA_CALLBACK_TOKEN_TRANSPORT=query_or_header
# Optional overrides for tx-status result/timeout callback URLs.
# MPESA_TX_STATUS_RESULT_URL=https://your-public-api-base.example.com/api/payments/mpesa/tx-status-callback
# MPESA_TX_STATUS_TIMEOUT_URL=https://your-public-api-base.example.com/api/payments/mpesa/tx-status-callback
# Subscription payment reconciliation policy
SUBSCRIPTION_RECON_LIMIT=50
SUBSCRIPTION_RECON_GRACE_SECONDS=90
SUBSCRIPTION_RECON_MAX_AGE_SECONDS=1800
SUBSCRIPTION_RECON_MAX_ATTEMPTS=8
SUBSCRIPTION_RECON_INTERVAL_SECONDS=60
SUBSCRIPTION_RECON_BACKOFF_SECONDS=30,60,120,180,300

# Security policy
# SECURITY_MODE: observe (log only) | enforce (block)
SECURITY_MODE=observe
# Set true when behind a trusted proxy/CDN that injects real client IP headers.
SECURITY_TRUST_PROXY_HEADERS=false
# Secondary ride-action abuse signals (same-WiFi safe defaults).
RIDE_ACTION_SECURITY_SIGNALS_ENABLED=true
RIDE_ACTION_SECURITY_IP_WINDOW_SECONDS=600
RIDE_ACTION_SECURITY_IP_MAX_EVENTS=40
RIDE_ACTION_SECURITY_IP_MAX_DISTINCT_USERS=8
RIDE_ACTION_SECURITY_DEVICE_WINDOW_SECONDS=600
RIDE_ACTION_SECURITY_DEVICE_MAX_EVENTS=25
RIDE_ACTION_SECURITY_DEVICE_MAX_DISTINCT_USERS=3
# In enforce mode, keep false unless you have a stable egress/IP posture.
RIDE_ACTION_SECURITY_ENFORCE_IP=false
# Comma-separated CIDRs for protected endpoints.
# OPS_IP_ALLOWLIST=102.214.72.132/32
# MPESA_CALLBACK_IP_ALLOWLIST=196.201.214.0/24

# Google Sign-In (ID token verification flow)
GOOGLE_CLIENT_ID_WEB=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_IDS_ALLOWED=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_IDTOKEN_ISSUERS=accounts.google.com,https://accounts.google.com

# Google Cloud Storage (private verification uploads)
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_VERIFICATION=your-private-verification-bucket
GCS_UPLOAD_PREFIX=verification/docs
GCS_SIGNED_URL_TTL_SECONDS=900
GCS_DOWNLOAD_URL_TTL_SECONDS=300
GCS_MAX_FILE_SIZE_BYTES=10485760
GCS_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-sa.json
FCM_PROJECT_ID=your-gcp-project-id
RIDE_PUSH_CLIENT=fcm
FCM_TIMEOUT_MS=10000
RIDE_OFFER_LOCK_MONITOR_ENABLED=true
RIDE_OFFER_LOCK_MONITOR_WINDOW_MS=60000
RIDE_OFFER_LOCK_MONITOR_MIN_ATTEMPTS=20
RIDE_OFFER_LOCK_UNAVAILABLE_RATIO_ALERT_THRESHOLD=0.05
RIDE_OFFER_LOCK_ALLOW_UNAVAILABLE_FALLBACK=false
RIDE_OFFER_LOCK_EXTERNAL_ALERTS_ENABLED=false
RIDE_OFFER_LOCK_EXTERNAL_ALERT_PROVIDER=raw
RIDE_OFFER_LOCK_EXTERNAL_ALERT_WEBHOOK_URL=
RIDE_OFFER_LOCK_EXTERNAL_ALERT_MIN_LEVEL=critical
RIDE_OFFER_LOCK_EXTERNAL_ALERT_TIMEOUT_MS=3000
RIDE_OFFER_LOCK_EXTERNAL_ALERT_AUTH_HEADER=
RIDE_OFFER_LOCK_EXTERNAL_ALERT_PAGERDUTY_ROUTING_KEY=
RIDE_OFFER_LOCK_EXTERNAL_ALERT_SLACK_CHANNEL=
RIDE_OFFER_LOCK_EXTERNAL_ALERT_SLACK_USERNAME=
MODERATION_MONITOR_ENABLED=true
MODERATION_MONITOR_WINDOW_MS=60000
MODERATION_TRIAGE_RATE_LIMITED_ALERT_COUNT=5
MODERATION_REVIEW_RATE_LIMITED_ALERT_COUNT=5
MODERATION_THROUGHPUT_MIN_PER_WINDOW=1
MODERATION_PENDING_REPORTS_ALERT_THRESHOLD=25
RIDE_MESSAGE_REPORT_WINDOW_DAYS=7
RIDE_MESSAGE_AUTO_RESTRICT_THRESHOLD=3
RIDE_MESSAGE_SIGNAL_COOLDOWN_DAYS=2

# Malware scanning
MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# OCR (Google Vision)
OCR_ENABLED=false
OCR_PDF_ENABLED=false

# Ride geofence enforcement
RIDE_PICKUP_ARRIVAL_RADIUS_M=120
RIDE_DROPOFF_COMPLETION_RADIUS_M=180
RIDE_LOCATION_FRESHNESS_SECONDS=120
RIDE_NO_SHOW_WAIT_SECONDS=300
RIDE_REQUIRE_GEOFENCE_ON_ARRIVE=true
RIDE_REQUIRE_GEOFENCE_ON_COMPLETE=true

# Ride integrity policy (cancellation/no-show fairness + rider prepay mode)
RIDE_INTEGRITY_ROLLING_WINDOW_DAYS=7
RIDE_INTEGRITY_RIDER_CHARGEABLE_THRESHOLD=5
RIDE_INTEGRITY_RIDER_CHARGEABLE_ESCALATION_THRESHOLD=8
RIDE_INTEGRITY_RIDER_PREPAY_ONLY_DAYS=7
RIDE_INTEGRITY_RIDER_PREPAY_ONLY_ESCALATION_DAYS=14
RIDE_INTEGRITY_DRIVER_CHARGEABLE_THRESHOLD=5
RIDE_INTEGRITY_DRIVER_CHARGEABLE_ESCALATION_THRESHOLD=8
RIDE_INTEGRITY_DRIVER_TEMP_SUSPENSION_DAYS=1
RIDE_INTEGRITY_DRIVER_TEMP_SUSPENSION_ESCALATION_DAYS=3
RIDE_INTEGRITY_RIDER_FREE_CANCEL_GRACE_SECONDS=120
RIDE_INTEGRITY_RIDER_DRIVER_LATE_WAIVER_SECONDS=300
RIDE_INTEGRITY_RIDER_DRIVER_LOCATION_STALE_SECONDS=120
RIDE_INTEGRITY_RIDER_NO_PROGRESS_ELAPSED_SECONDS=180
RIDE_INTEGRITY_RIDER_NO_PROGRESS_DELTA_M=100
RIDE_INTEGRITY_RIDER_MOVING_AWAY_ELAPSED_SECONDS=120
RIDE_INTEGRITY_RIDER_MOVING_AWAY_DELTA_M=300
RIDE_INTEGRITY_RIDER_PICKUP_FAR_DISTANCE_M=2000
RIDE_INTEGRITY_RIDER_PREPAY_PAYMENT_MODE=in_app_mpesa
RIDE_PICKUP_AUTO_REASSIGN_ENABLED=true
RIDE_PICKUP_AUTO_REASSIGN_AFTER_SECONDS=420
RIDE_PICKUP_FAST_REASSIGN_ENABLED=true
RIDE_PICKUP_FAST_REASSIGN_AFTER_SECONDS=180
RIDE_PICKUP_AUTO_CANCEL_ENABLED=true
RIDE_PICKUP_AUTO_CANCEL_AFTER_SECONDS=900
RIDE_PICKUP_AUTO_CANCEL_MIN_REASSIGN_COUNT=1
RIDE_PICKUP_WATCHDOG_LIMIT=100
RIDE_SUPPLY_S2_LEVEL=13
RIDE_SUPPLY_ZONE_TTL_SECONDS=180
RIDE_SUPPLY_DRIVER_TTL_SECONDS=180
RIDE_SUPPLY_LOOKUP_CELL_LIMIT=225
RIDE_SHARED_MAX_EXTRA_DETOUR_M=2000
RIDE_SHARED_MAX_EXTRA_DETOUR_RATIO=0.6
RIDE_SHARED_ETA_GOOGLE_ENABLED=false
RIDE_SHARED_ETA_FALLBACK_SPEED_KPH=28
RIDE_SHARED_ETA_MIN_LEG_SECONDS=60
RIDE_SHARED_ETA_MAX_LEG_SECONDS=7200
RIDE_SHARED_ETA_REFRESH_MIN_INTERVAL_SECONDS=15
RIDE_DISPATCH_ETA_ENABLED=true
RIDE_DISPATCH_ETA_PROBE_LIMIT=8
RIDE_DISPATCH_ETA_MAX_CONCURRENCY=4
RIDE_DISPATCH_ETA_TIMEOUT_MS=1200
RIDE_DISPATCH_ETA_FALLBACK_SPEED_KPH=28
RIDE_DISPATCH_ETA_MIN_SECONDS=30
RIDE_DISPATCH_ETA_MAX_SECONDS=7200
RIDE_DRIVER_LIVENESS_ONLINE_MAX_AGE_SECONDS=90
RIDE_DRIVER_LIVENESS_OFFLINE_AFTER_SECONDS=240

# Ratings
RATING_WINDOW_HOURS=24
RATING_DECAY_PER_DAY=0.01
RATING_SMOOTHING_PRIOR_MEAN=4.8
RATING_SMOOTHING_PRIOR_WEIGHT=20
RATING_ENFORCEMENT_RECENT_WINDOW_DAYS=30
RATING_ENFORCEMENT_MIN_RECENT_RATINGS=20
RATING_NON_ATTRIBUTABLE_REASON_TAGS=traffic,app_issue,gps_issue,wrong_pickup_pin,co_rider_behavior
RETENTION_AUTH_CHALLENGES_TTL_DAYS=7
RETENTION_IDEMPOTENCY_TTL_DAYS=30
RETENTION_WEBHOOK_EVENTS_TTL_DAYS=180
AUTH_TOTP_ISSUER=Liddr
AUTH_TOTP_SETUP_TTL_SECONDS=600
