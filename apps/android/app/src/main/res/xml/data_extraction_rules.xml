<?xml version="1.0" encoding="utf-8"?>
<!-- Session tokens never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="liddr_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="liddr_session.xml" />
    </device-transfer>
</data-extraction-rules>
