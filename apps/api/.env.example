# Copy to .env for local use. Never commit real values.

# Database. `make db-up` starts Postgres on 127.0.0.1:55432 with these
# credentials (liddr when blank, which the Makefile's TEST_DATABASE_URL expects).
# DATABASE_URL may refer to them as ${NAME}; the API expands that itself.
POSTGRES_DB=liddr
POSTGRES_USER=liddr
POSTGRES_PASSWORD=liddr
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:55432/${POSTGRES_DB}?sslmode=disable
# One pool shared by the API and its workers (default 20). Every process's
# pool together must stay below Postgres max_connections, 100 by default.
DB_MAX_CONNS=10

# Redis. `make db-up` starts it on 127.0.0.1:56380. Nothing in the API reads
# these yet.
REDIS_PASSWORD=liddr
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:56380

# Where the API listens.
ADDR=127.0.0.1:8080

# At least 32 bytes. Generate with: openssl rand -base64 48
AUTH_HMAC_KEY=

# Encrypts critical columns. Exactly 32 bytes as base64: openssl rand -base64 32
# Changing it makes existing authenticators and sealed values unreadable.
DATA_ENCRYPTION_KEY=

# Optional comma-separated CIDR ranges allowed to reach ops and admin routes.
# Empty allows any address, though MFA is still required.
OPS_ALLOWED_CIDRS=
# The staff console's exact origin, such as https://ops.example.com. Set, staff
# sign in there with session cookies (/v1/auth/web/*); empty, those routes do
# not exist. Use http://127.0.0.1:5173 with the console's dev server.
OPS_CONSOLE_ORIGIN=

# Onfon Media SMS (sign-in codes). ONFON_API_URL defaults to
# https://api.onfonmedia.co.ke. The sender ID must be approved by Onfon.
ONFON_API_URL=
ONFON_API_KEY=
ONFON_CLIENT_ID=
ONFON_ACCESS_KEY=
ONFON_SENDER_ID=

GOOGLE_MAPS_API_KEY_SERVER=

# sandbox unless set to production.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# The till and its Lipa na M-Pesa passkey (64 characters). Required in
# production. Empty in sandbox uses Safaricom's public test till 174379.
# This is not the initiator security credential, which is much longer.
MPESA_SHORTCODE=
MPESA_PASSKEY=
# The public address Safaricom will call back.
MPESA_CALLBACK_BASE_URL=
# At least 32 URL-safe bytes. Generate with: openssl rand -hex 32
MPESA_CALLBACK_TOKEN=
# Optional comma-separated Safaricom addresses. Empty allows any address. Leave
# empty in sandbox. In production, Safaricom's published callback addresses:
# 196.201.214.200,196.201.214.206,196.201.213.114,196.201.214.207,196.201.214.208,196.201.213.44,196.201.212.127,196.201.212.138,196.201.212.129,196.201.212.136,196.201.212.74,196.201.212.69
MPESA_CALLBACK_ALLOWED_IPS=

# Driver documents in Cloudflare R2. Leave R2_BUCKET empty to run without
# uploads. Once set, the bucket must be private (no r2.dev URL or custom domain)
# and the rest are required. The token is an R2 API token with Object Read &
# Write on this one bucket. R2_ACCOUNT_ID is the 32-character account ID.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# host:port of a ClamAV daemon. Files are never reviewable without a clean scan.
CLAMAV_ADDR=

# Rider sign-in by email. Leave RESEND_API_KEY empty to turn it off.
RESEND_API_KEY=
OTP_EMAIL_FROM=
# Comma-separated OAuth client ids allowed to sign in with Google. Empty turns it off.
GOOGLE_CLIENT_IDS=

# Firebase push. Leave FCM_PROJECT_ID empty to keep notifications in the app only.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# How many proxies in front of the API append to X-Forwarded-For. Must be set
# correctly in production: at 0 behind a load balancer, every user shares one
# address and the per-IP sign-in limit applies to all of them together.
TRUSTED_PROXY_HOPS=0

# Exact web origins allowed to open sockets, comma-separated. Native apps send no
# Origin header and need no entry.
REALTIME_ALLOWED_ORIGINS=
